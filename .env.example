# halo-trade server settings. Copy to .env and edit. Never put a secret or key in this file.
# Values shown are the defaults from src/halo_trade/config.py. docs/RUNBOOK.md says which must change.

# ---- Must be set for any real deployment (the defaults are for the local mock) ----
HALO_CHAIN_BACKEND=mock
HALO_NETWORK=testnet
HALO_PUBLIC_BASE_URL=http://127.0.0.1:18080
# Path inside the container to the grantee key file, mode 600. Never set a key here, only a path.
HALO_GRANTEE_KEY_PATH=
# Where alerts are posted. Empty means alerts are stored and logged but nobody is notified.
HALO_ALERT_WEBHOOK=
# Comma-separated IPs or CIDRs of the reverse proxy in front of the service. Never *.
HALO_TRUSTED_PROXY=

# ---- Mainnet only (real money, human action, see docs/RUNBOOK.md) ----
# Must equal exactly yes-real-money to allow mainnet.
HALO_ALLOW_MAINNET=

# ---- Build-time pins: what the web page accepts from the server. Set before --build. ----
# Empty is allowed on testnet. On mainnet the page refuses to run without both.
HALO_EXPECTED_GRANTEE_TESTNET=
HALO_EXPECTED_MARKET_ID_TESTNET=
HALO_EXPECTED_GRANTEE_MAINNET=
HALO_EXPECTED_MARKET_ID_MAINNET=

# ---- Market and chain ----
HALO_MARKET_TICKER="BTC/USDC PERP"
# Empty means HALO_NETWORK. On testnet it may be mainnet, for read-only candles.
HALO_CANDLE_NETWORK=
# "binance" takes analysis candles from the wider market, so a quiet hour on the chain cannot stall the agent.
HALO_CANDLE_SOURCE=
HALO_TX_TIMEOUT_BLOCKS=20
HALO_STOP_GRACE_BLOCKS=5
HALO_GRANTEE_MIN_INJ=0.05

# ---- Service ----
# compose.yaml sets this to /data/halo.sqlite for the server container.
HALO_DB_PATH=halo.sqlite
HALO_MAX_USERS=20
# Seconds between reads of wallets with a position or an unfinished order.
HALO_WATCH_INTERVAL_S=5
# Seconds between reads of every other wallet, 0 to 600. 0 means every tick.
HALO_WATCH_FLAT_INTERVAL_S=60
# Wallets the watcher works on at once, 1 to 200.
HALO_WATCH_CONCURRENCY=20
# Requests per second to the chain nodes and to the indexer and chart API, 1 to 1000. All of them leave from one IP: the public nodes allow 20 and 50.
HALO_CHAIN_RPS=15
HALO_INDEXER_RPS=30

# ---- Hosted agent. Empty key or model: the agent cannot be started, nothing else changes ----
# Any OpenAI-compatible endpoint. https unless localhost. A plain path is allowed, no query string.
HALO_LLM_BASE_URL=https://openrouter.ai/api/v1
# Secret: set it only in the real .env, never here.
HALO_LLM_API_KEY=
# Model id at that endpoint. With OpenRouter, do not set provider `order` or `require_parameters`.
HALO_LLM_MODEL=
# Seconds per LLM call. Two tries must fit inside the 120 s observation lifetime.
HALO_LLM_TIMEOUT_S=45
# Decision-lane LLM calls per UTC day across all users. The other lanes have their own pools below.
HALO_LLM_DAILY_CALLS=3000
# Decision-lane LLM calls per UTC day for one user.
HALO_LLM_USER_DAILY_CALLS=200
# Seconds between one user's decisions. At least 60. Limits are enforced by the server whatever this is.
HALO_DECISION_INTERVAL_S=900
# Decisions running at once, 1 to 100.
HALO_DECISION_CONCURRENCY=10
# Most decisions started per 20-second tick, 1 to 1000.
HALO_DECISION_MAX_PER_TICK=30

# ---- Price-event wakeups. A wake only brings a wallet's next decision forward. ----
# Seconds between market reads for the whole service, 1 to 60.
HALO_MONITOR_INTERVAL_S=3
# Wake when the mark has moved this many 1h ATRs since the wallet's last decision. Above 0, at most 20.
HALO_WAKE_MOVE_ATR=1.0
# Wake when an open position's mark is within this many 1h ATRs of its stop. Above 0, at most 20.
HALO_WAKE_STOP_ATR=0.5
# Fewest seconds between two wakes of one wallet, 30 to 86400.
HALO_WAKE_COOLDOWN_S=300
# A scheduled cycle with no position skips the LLM if the mark moved less than this many ATRs. 0 turns this off. Must be below HALO_WAKE_MOVE_ATR.
HALO_SKIP_MOVE_ATR=0.25
# Longest that cycles may skip the LLM in a row, in seconds, 0 to 86400.
HALO_MAX_SKIP_S=3600

# ---- Market desk: public market data and headlines on one shared loop ----
# 1 runs the desk, 0 turns it off. Nothing else is needed: the sources are fixed in the code.
HALO_DESK_ENABLED=1

# ---- LLM lanes around the decision. Each has its own pool, so none can spend a decision's budget ----
# Research calls per UTC day across all wallets, and for one wallet. 0 skips the step, and the cycle still decides.
HALO_RESEARCH_DAILY_CALLS=6000
HALO_RESEARCH_USER_DAILY_CALLS=300
# Reflection calls per UTC day across all wallets, and for one wallet.
HALO_REFLECT_DAILY_CALLS=480
HALO_REFLECT_USER_DAILY_CALLS=24
# Market analyst calls per UTC day for the whole service. One every 30 minutes needs 48.
HALO_ANALYST_DAILY_CALLS=96

# ---- Telegram. Empty token: no link button, no webhook, no notifications ----
# Secret: set it only in the real .env, never here.
HALO_TELEGRAM_BOT_TOKEN=
# The bot's username, without @. Used to build the link button.
HALO_TELEGRAM_BOT_USERNAME=
# Secret sent back by Telegram in X-Telegram-Bot-Api-Secret-Token. Set it only in the real .env.
# At least 32 characters: startup refuses less when a bot token is set.
HALO_TELEGRAM_WEBHOOK_SECRET=
# Free-text chat messages per user per UTC day.
HALO_CHAT_DAILY_LIMIT=30
# Most LLM steps for one chat message.
HALO_CHAT_MAX_STEPS=4
# Chat LLM calls per UTC day across all users. Separate from the decision lane's pool.
HALO_CHAT_GLOBAL_DAILY_CALLS=600
# Chat tokens (input + output) per user per UTC day, checked before each step.
HALO_CHAT_USER_DAILY_TOKENS=300000

# ---- Risk limits (src/halo_trade/config.py) ----
# The server refuses to start with leverage over 5, risk per trade over 0.1, daily loss over 0.25 or drawdown over 0.5.
HALO_RISK_PER_TRADE=0.03
HALO_MAX_LEVERAGE=2
HALO_INTERNAL_CAP=0.98
HALO_MIN_STOP_PCT=0.005
HALO_COLLAR=0.003
HALO_STOP_WORST_PCT=0.015
HALO_CLOSE_WORST_PCT=0.03
HALO_DRIFT_MAX=0.0025
HALO_MAX_RISK_GROWTH=1.5
HALO_DAILY_LOSS=0.06
HALO_MAX_DRAWDOWN=0.30
HALO_MIN_TP_COST_MULT=3
HALO_MAX_EQUITY_USD=400
HALO_MIN_DEPOSIT_USD=50
HALO_MAX_DEPOSIT_USD=200
HALO_COOLDOWN_WINDOWS=2

# ---- Tooling only, not read by the server ----
# web/scripts/simulate-testnet.mjs (read-only testnet simulation):
# HALO_SIMULATE_LCD=
# HALO_SIMULATE_NETWORK=testnet
# HALO_SIMULATE_ADDRESS=
# HALO_SIMULATE_DUMP=
# HALO_GRANTEE=
# HALO_MARKET_ID=
# HALO_USDC_DENOM=
